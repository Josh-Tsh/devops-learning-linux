# Navigation
cd /var/log
ls -lah
pwd

# File operations
touch test.txt
mkdir -p projects/demo
cp test.txt projects/demo/
mv projects/demo/test.txt projects/demo/backup.txt
rm projects/demo/backup.txt
vim test.txt   # edit file

# Viewing files
cat /etc/passwd
less /var/log/syslog
head -n 20 /etc/services
tail -f /var/log/auth.log

# Users / Groups
sudo useradd newuser
# Creates the user, but usually does NOT create a home directory

sudo useradd -m newuser
# Creates the user AND a home directory

sudo groupadd newgroup
# Creates a new group

sudo usermod -aG newgroup newuser
# Adds newuser to newgroup
# -a = append
# -G = supplementary groups

sudo gpasswd -d newuser newgroup
# Removes newuser from newgroup
# Permissions
ls -l
chmod 755 file
chmod +x script.sh
chown user:group file
sudo chown user:group file

# Searching
find /path -name "file.txt"
grep "word" file.txt
grep -r "word" directory/
which python3

# Find
find . -name "file.txt"                     # find file by name
find . -iname "file.txt"                    # find file, ignore case
find . -type f                              # find files only
find . -type d                              # find directories only
find . -type f -size 1033c                  # find file exactly 1033 bytes
find . -type f -size +10M                   # find files larger than 10MB
find . -type f -size -10M                   # find files smaller than 10MB
find . -type f -executable                  # find executable files
find . -type f ! -executable                # find non-executable files
find . -type f -readable                    # find readable files
find . -type f -user username               # find files owned by user
find . -type f -group groupname             # find files owned by group
find . -type f -mtime -1                    # modified in last 24 hours
find . -type f -mmin -30                    # modified in last 30 minutes
find / -name "file.txt" 2>/dev/null         # search whole system, hide errors
find . -type f -exec file {} \;             # show file type of results
find . -type f -exec ls -lh {} \;           # show results with human-readable sizes

# File information
file filename
stat filename
du -sh directory/
df -h

# Processes
ps aux
top
kill PID
kill -9 PID

# Networking
ip addr
ip route
ping google.com
ss -tulpn
hostname

# Redirection / Pipes
command > file.txt
command >> file.txt
command 2> errors.txt
command1 | command2

# Shell / Environment
echo $PATH
export NAME="Josh"
source ~/.bashrc
history

# Archives
tar -cvf archive.tar folder/
tar -xvf archive.tar
tar -czvf archive.tar.gz folder/
tar -xzvf archive.tar.gz

# Standard file descriptors
0 = stdin
1 = stdout
2 = stderr
